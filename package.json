{
  "name": "dsh-todo-freshness",
  "version": "0.2.0",
  "type": "module",
  "description": "Says out loud when the DSH task list is a stale snapshot instead of live progress, and nudges the model to write back.",
  "license": "MIT",
  "author": "lizhi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaomengxinbb/dsh-todo-freshness.git"
  },
  "homepage": "https://github.com/xiaomengxinbb/dsh-todo-freshness#readme",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "todo",
    "task-list",
    "todo-write"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/fold.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.2.3-0 || >=0.2.3-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.2.3-0 || >=0.2.3-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
